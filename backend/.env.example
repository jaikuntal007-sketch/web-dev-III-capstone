# Server
PORT=5000
NODE_ENV=development

# MongoDB (local MongoDB / MongoDB Compass connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_management

# JWT - use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend origin allowed by CORS and Socket.IO
CLIENT_URL=http://localhost:5173
